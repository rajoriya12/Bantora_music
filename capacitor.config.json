{
  "appId": "com.bantora.music",
  "appName": "Bantora",
  "webDir": "www",
  "ios": {
    "contentInset": "automatic",
    "backgroundColor": "#070709",
    "preferredContentMode": "mobile",
    "allowsLinkPreview": false,
    "scrollEnabled": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1200,
      "launchAutoHide": true,
      "backgroundColor": "#070709",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "dark",
      "backgroundColor": "#070709"
    }
  }
}
